# Copy this file to .env. Never commit the real .env file.

# LiteLLM administrator key. It must start with sk-.
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-value

# Encrypts provider credentials stored in PostgreSQL. Set it once and do not rotate it.
LITELLM_SALT_KEY=replace-with-a-different-long-random-value

# PostgreSQL. Use a long URL-safe password because it is embedded in DATABASE_URL.
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

# Cloudflare Zero Trust tunnel token.
TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
