# Cloudflare Zero Trust Dashboard -> Networks -> Tunnels -> Create a tunnel -> Docker。
# 复制页面提供的 token（只复制 token 值，不要复制整个 docker run 命令）。
TUNNEL_TOKEN=your_cloudflare_tunnel_token

# Firefly III 的 32 字符应用密钥。部署主机执行：openssl rand -hex 16
# 生成后保存此值；更换会使现有会话和加密数据失效。
APP_KEY=your_32_character_firefly_app_key

# Firefly III 与其 MariaDB 共用的数据库密码。部署主机执行：openssl rand -hex 24
# 数据库卷首次初始化后请勿随意修改此值。
MYSQL_PASSWORD=your_firefly_database_password

# Firefly III 定时任务的访问令牌。部署主机执行：openssl rand -hex 32
STATIC_CRON_TOKEN=your_firefly_cron_token

# WordPress MySQL root 密码。部署主机执行：openssl rand -hex 24
# 数据库卷首次初始化后请勿随意修改此值。
MYSQL_DATABASE_PASSWORD=your_wordpress_database_root_password
